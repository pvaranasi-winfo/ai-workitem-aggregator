// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Microsoft Entra ID fields
  entraId        String?  @unique
  displayName    String?
  jobTitle       String?
  department     String?
  officeLocation String?
  
  // Resource tagging
  resourceType   String?  // "Dedicated", "Shared", "Unassigned"
  
  integrations Integration[]
  tickets      Ticket[]
  userProjects UserProject[]
  leaves       Leave[]
}

model Integration {
  id           String   @id @default(cuid())
  userId       String
  platform     String   // jira, github, gitlab, azure-devops, bitbucket, kantata
  name         String   // User-friendly name for this integration
  token        String   // Encrypted token
  baseUrl      String?  // For self-hosted instances
  username     String?  // For some platforms that need it
  metadata     String?  // JSON string for platform-specific data (e.g., Kantata OAuth data)
  isActive     Boolean  @default(true)
  lastSyncedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tickets Ticket[]
  
  @@unique([userId, platform, name])
  @@index([userId])
}

model Ticket {
  id             String   @id @default(cuid())
  userId         String
  integrationId  String
  externalId     String   // ID from the external system
  platform       String   // jira, github, gitlab, azure-devops, bitbucket
  title          String
  description    String?
  status         String
  priority       String?
  type           String?  // bug, feature, task, etc.
  assignee       String?
  reporter       String?
  projectKey     String?
  projectName    String?
  labels         String?  // JSON array stored as string
  url            String?
  createdAt      DateTime
  updatedAt      DateTime
  dueDate        DateTime?
  syncedAt       DateTime @default(now())
  
  // Time tracking fields
  estimatedHours  Float?   @default(0)
  loggedHours     Float?   @default(0)
  remainingHours  Float?   @default(0)
  sprint          String?
  storyPoints     Int?
  ticketId        String?  // Display ticket ID (e.g., PROJ-123)
  
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  timeEntries TimeEntry[]
  
  @@unique([integrationId, externalId])
  @@index([userId])
  @@index([integrationId])
  @@index([status])
  @@index([sprint])
}

model TimeEntry {
  id          String   @id @default(cuid())
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  date        DateTime @default(now())
  hours       Float
  description String?
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([ticketId])
  @@index([userId])
  @@index([date])
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String?
  capacity    Float?   // Team capacity in hours/week
  location    String?  // Office location or remote
  status      String   @default("Active") // Active, Inactive, Archived
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  userProjects UserProject[]
  
  @@index([status])
}

model UserProject {
  id              String   @id @default(cuid())
  userId          String
  projectId       String
  role            String?  // Developer, Lead, Manager, etc.
  allocationPercentage Float? @default(100) // Percentage of time allocated
  startDate       DateTime?
  endDate         DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
}

model EntraConfig {
  id           String   @id @default(cuid())
  tenantId     String
  clientId     String
  clientSecret String   // Encrypted
  isEnabled    Boolean  @default(false)
  syncInterval Int      @default(24) // Hours between syncs
  lastSyncedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Leave {
  id          String   @id @default(cuid())
  userId      String
  leaveType   String   // Annual, Sick, Personal, etc.
  startDate   DateTime
  endDate     DateTime
  days        Float    // Number of days (can be 0.5 for half day)
  status      String   @default("Approved") // Approved, Pending, Rejected
  reason      String?
  source      String?  // jira, azure-devops, manual, etc.
  externalId  String?  // ID from external system
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([startDate])
  @@index([endDate])
}
